# ==============================================================================
# Safaricom Daraja M-Pesa Configuration
# ==============================================================================
# Environment: 'sandbox' (testing) or 'production' (live)
# Switching to 'production' automatically switches the Base URL to https://api.safaricom.co.ke
# and the default Shortcode to 678408 without code changes.
MPESA_ENV=sandbox

# Shortcode used as BusinessShortCode and PartyB:
# Sandbox: 174379 | Production: 678408
MPESA_SHORTCODE=174379

# Account Reference shown on customer M-Pesa statement
MPESA_ACCOUNT_REF=3RDMASSCHOIR

# Safaricom Daraja Developer Credentials (obtained from developer.safaricom.co.ke)
# Leave empty in code; add your keys here:
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=

# Public HTTPS Callback URL where Safaricom posts transaction results:
# Example for local development with ngrok: https://xxxx.ngrok-free.app/api/mpesa/callback
# Example for production: https://yourdomain.com/api/mpesa/callback
MPESA_CALLBACK_URL=